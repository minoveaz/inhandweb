{
  "name": "inhand-storefront",
  "private": true,
  "version": "1.0.0",
  "description": "INHAND — Made to Mean More. Editorial E-Commerce Storefront (ES/EN)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit && vite build && node scripts/generate_sitemap.cjs",
    "preview": "vite preview --port 4180",
    "typecheck": "tsc --noEmit",
    "validate:seo": "node scripts/validate_seo.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
